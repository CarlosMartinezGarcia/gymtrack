{
  "name": "gymtrack",
  "version": "1.0.0",
  "private": true,
  "description": "Registro personal de entrenamiento de fuerza (PWA).",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "preview": "node scripts/serve.mjs",
    "test": "node --import tsx --test tests/unit/*.test.ts",
    "test:e2e": "node scripts/build.mjs && node --import tsx tests/e2e/acceptance.ts",
    "test:sync": "node scripts/build.mjs && node --import tsx tests/e2e/sync.ts",
    "typecheck": "tsc --noEmit",
    "icons": "node scripts/icons.mjs"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "esbuild": "^0.25.0",
    "playwright": "^1.56.0",
    "sharp": "^0.34.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=20"
  }
}
